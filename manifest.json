{
  "id": "pantry",
  "name": "Pantry Inventory",
  "version": "1.0.0",
  "description": "Track what's in the fridge, freezer, and pantry — quantities, expiration dates, and what's running low. One tap pushes a depleted item to the Grocery List. Works for a single household or a shared communal kitchen with per-item owners and restock requests.",
  "entrypoint": "index.html",
  "runtime": "static",
  "icon": "🥫",
  "category": "food",
  "tags": ["food", "pantry", "inventory", "kitchen", "grocery"],
  "storage": "db",
  "automation_actions": {
    "add_item": {
      "title": "Stock a pantry item",
      "description": "Add something to the kitchen inventory when another app's event fires - groceries bought, a delivery received, a staple restocked.",
      "params": {
        "created_by_id": {
          "type": "member",
          "label": "Stocked by",
          "required": true
        },
        "name": {
          "type": "text",
          "label": "Item",
          "required": true
        },
        "category": {
          "type": "text",
          "label": "Where it lives",
          "default": "pantry",
          "options": ["fridge", "freezer", "pantry", "other"]
        },
        "quantity": {
          "type": "integer",
          "label": "How many",
          "default": 1,
          "min": 0
        }
      },
      "dedupe": {
        "table": "items",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "items",
          "values": {
            "id": "$uuid",
            "name": ":name",
            "category": ":category",
            "quantity": ":quantity",
            "created_by_id": ":created_by_id",
            "created_by_name": "Automation",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "db_plaintext_columns": ["expiry_date", "name"],
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": ["family.members"],
    "writes": ["app.grocery.pending_items"]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "member_references": {
    "items": {
      "column": "created_by_id",
      "on_removed": "keep"
    }
  },
  "publishes": ["pantry.item_added", "pantry.item_low"],
  "publish_acls": {"pantry.item_added": {"require_role": "member"}, "pantry.item_low": {"require_role": "member"}},
  "agenda": {"kind": "reminder", "label": "Expiring", "source": {"kind": "sql", "query": "SELECT id AS id, name AS title, category AS subtitle, expiry_date AS when_at FROM app_pantry__items WHERE expiry_date = :today LIMIT 20"}},
  "nav": { "label": "Pantry" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_pantry__items WHERE status != 'ok' LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "running low", "severity": "warn" }
  },
  "resource_limits": {
    "max_db_bytes": 10485760,
    "max_store_writes_per_day": 500
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["low_items", "expiring_items"]
  }
}
